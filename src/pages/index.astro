---
import Site from "../layouts/site.astro";
import Icon from "../components/icon.astro";
import Card from "../components/project-card.astro";
import { awards, education, featured } from "../data/portfolio";
---
<Site title="홈">
  <section class="hero"><div class="wrap hero-inner">
    <div>
      <h1>소프트웨어 개발자<br/><strong>김현석<span class="name-stop">.</span></strong></h1>
      <div class="hero-profile"><img src="/media/portrait.webp" width="38" height="47" alt="김현석 프로필 사진"/><div><strong>상명대학교 전기공학 학사</strong><span>삼성청년SW·AI아카데미 15기</span></div></div>
    </div>
    <div class="hero-copy">
      <p>팀이 함께 편집하는 <a href="/projects/interface-map/">설계 도구</a>를 만들어 운영합니다.<br/>항공영상에서 <a href="/projects/solar-vision/">태양광 패널</a>을 찾고, <a href="/projects/jetank/">로봇팔</a>이 카메라로 찾은 블록을 집도록 제어했습니다.</p>
      <div class="hero-actions"><a href="#selected" class="btn primary">대표 프로젝트 보기 <Icon name="arrow"/></a><a href="/resume/" class="btn secondary"><Icon name="file" size={17}/>이력서 보기</a><a class="text-link" href="/pdf/kim-hyeonseok-portfolio.pdf" download>포트폴리오 PDF</a></div>
    </div>
  </div></section>
  <section class="wrap works" id="selected" aria-labelledby="works-title">
    <div class="section-head"><h2 id="works-title">대표 프로젝트 <span class="count">{String(featured.length).padStart(2,"0")}</span></h2><a class="text-link" href="/projects/">전체 프로젝트 <Icon name="arrow" size={17}/></a></div>
    <div class="card-grid">{featured.map(project => <Card project={project}/>)}</div>
  </section>
  <section class="experience"><div class="wrap experience-inner">
    <div class="profile-thumb"><h2>학력과 수상</h2><a class="text-link" href="/resume/">이력서 보기 <Icon name="arrow" size={16}/></a></div>
    <div class="experience-cols"><div><h3>학력 및 교육</h3>{education.map(([date, title, desc])=><div class="cv-brief"><small>{date}</small><strong>{title}</strong><p>{desc}</p></div>)}</div>
    <div><h3>주요 수상</h3>{[awards[0],awards[1],awards[3]].map(([date,title,org])=><div class="cv-brief"><small>{date}</small><strong>{title}</strong><p>{org}</p></div>)}</div></div>
  </div></section>
</Site>
