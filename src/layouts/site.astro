---
import "@fontsource-variable/manrope";
import "@fontsource-variable/noto-sans-kr";
import "../styles/site.css";
import Icon from "../components/icon.astro";
import { contact } from "../data/portfolio";
interface Props { title: string; description?: string; image?: string; }
const { title, description = "웹서비스, AI와 로봇 제어 프로젝트에서 김현석이 해결한 문제와 직접 구현한 내용을 소개합니다.", image = "/media/portfolio-og.png" } = Astro.props;
const path = Astro.url.pathname === "/404/" || Astro.url.pathname === "/404" ? "/404.html" : Astro.url.pathname;
const nav = [["/", "소개"], ["/projects/", "프로젝트"], ["/resume/", "이력서"]];
const label = title === "홈" ? "김현석 | 소프트웨어 개발자 포트폴리오" : title + " | 김현석 포트폴리오";
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{label}</title><meta name="description" content={description} /><meta name="theme-color" content="#f9fafb" />
  <link rel="icon" href="/mark.svg" type="image/svg+xml" /><link rel="canonical" href={new URL(path, Astro.site)} />
  {path === "/404.html" && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" /><meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={label} /><meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(path, Astro.site)} /><meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body id="top">
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="masthead"><div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="김현석 포트폴리오 홈"><img src="/mark.svg" width="34" height="34" alt="" /><strong>김현석</strong><span class="brand-note" lang="en">Portfolio</span></a>
    <nav aria-label="주 메뉴">{nav.map(([href, text]) => <a href={href} aria-current={(href === "/" ? path === "/" : path.startsWith(href)) ? "page" : undefined}>{text}</a>)}</nav>
    <a class="github-top" href={contact.github} aria-label="김현석 GitHub"><Icon name="github" size={16} /><span>GitHub</span><Icon name="external" size={13} /></a>
  </div></header>
  <main id="main"><slot /></main>
  <footer class="footer"><div class="wrap footer-inner"><div><a class="brand footer-brand" href="/"><img src="/mark.svg" width="29" height="29" alt="" /><strong>김현석</strong></a><span class="footer-role">소프트웨어 개발자</span></div><div class="footer-links"><a href={"mailto:" + contact.email}>{contact.email}</a><a href={contact.github}>GitHub <Icon name="external" size={13} /></a><a href="#top" class="to-top" aria-label="맨 위로"><Icon name="up" size={16}/></a></div></div></footer>
</body>
</html>
