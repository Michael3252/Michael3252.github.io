---
const guides = [
  { field: "ai", text: "AI 인식", id: "sense" },
  { field: "service", text: "웹서비스", id: "service" },
  { field: "robotics", text: "로봇 제어", id: "motion" }
];
---
<figure class="arm-figure">
  <div class="blueprint-paper" aria-hidden="true"></div>
  <svg class="arm-rules" viewBox="0 0 540 382" preserveAspectRatio="none" aria-hidden="true">
    <g fill="none" stroke="currentColor"><ellipse cx="275" cy="192" rx="177" ry="158" stroke-dasharray="3 7"/><path d="M77 196h394M279 20v337" stroke-dasharray="6 9" opacity=".5"/>
    <path d="M23 28v-9h9m476 0h9v9M23 350v9h9m476 0h9v-9" stroke-width="1.3"/></g>
  </svg>
  <img class="hero-arm" src="/media/so101.webp" alt="열린 그리퍼와 다섯 관절이 보이는 SO-ARM101 로봇팔 구조 렌더링" width="1040" height="1321" fetchpriority="high"/>
  <svg class="arm-leaders" viewBox="0 0 540 382" preserveAspectRatio="none" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1"><path d="M90 92h35l29-35h36"/><path d="M420 133h-41l-17 17h-32"/><path d="M118 268h54l19-19h131"/></g>
    <g fill="currentColor"><circle cx="190" cy="57" r="3"/><circle cx="330" cy="150" r="3"/><circle cx="322" cy="249" r="3"/></g>
    <g transform="translate(452 310)" fill="none" stroke-width="1.4"><path d="M0 17V-7" stroke="#4160a3"/><path d="M0 17 21 23" stroke="#d06e48"/><path d="M0 17-17 29" stroke="#548077"/></g>
  </svg>
  {guides.map(g => <a class={"callout " + g.id} href={"/projects/field/" + g.field + "/"} aria-label={g.text + " 분야 프로젝트 보기"}>{g.text}</a>)}
  <figcaption><span>SO-ARM101</span> 구조 설명 모델</figcaption>
</figure>
